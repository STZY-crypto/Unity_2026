# for changing colour of an object in play mode in unity
using UnityEngine;

public class NewMonoBehaviourScript : MonoBehaviour
{
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {
       
    }

    // Update is called once per frame
    void Update()
    { 
   
        if (Input.GetKey(KeyCode.R))
    {
        Debug.Log("Blue");
            gameObject.GetComponent<Renderer>().material.color = new Color32(37, 150, 190, 255) ;
        }
        if (Input.GetKey(KeyCode.O))
        {
            Debug.Log("Orange");
            gameObject.GetComponent<Renderer>().material.color = new Color32(255, 194, 168,255) ;

        }
        if (Input.GetKey(KeyCode.A))
        {
            Debug.Log("Apple");
            gameObject.GetComponent<Renderer>().material.color = new Color32(182, 13, 30, 255);

        }
    }
}
