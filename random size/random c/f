using UnityEngine;

public class randomcolour : MonoBehaviour
{
    public Color theColor;
    // Start is called once before the first execution of Update after the MonoBehaviour is created
    void Start()
    {

    }

    // Update is called once per frame
    void Update()
    {
        if (Input.GetKeyDown(KeyCode.Space))
        {
            theColor = new Color(Random.value, Random.value, Random.Range(0,1f), 1);
            gameObject.GetComponent<Renderer>().material.color = theColor;
            gameObject.transform.localScale = gameObject.transform.localScale* Random.Range(0.5f, 1.5f);
        }
    }
}
 
